# ───────────────────────────────────────────────
#  IDENTIDAD DEL BOT
# ───────────────────────────────────────────────
BOT_NAME=NombreBot
BOT_VERSION=1.0.0
# Prefijo de los comandos. Nota: en Termux existe una variable del sistema
# llamada PREFIX (una ruta); el bot la ignora y usa este valor. Si prefieres
# definirlo desde la terminal, usa BOT_PREFIX.
PREFIX=.
# Acepta ademas los prefijos habituales (. ! # / , ; $ &). Ponlo en false para
# que el bot solo responda al prefijo de arriba.
MULTI_PREFIX=true
OWNER_NAME=Owner
# Numero del propietario en formato internacional, SIN "+" ni espacios.
# Ejemplo: 5215512345678  (puedes separar varios con comas)
OWNER_NUMBER=
# public = cualquiera puede usar el bot | private = solo el owner
BOT_MODE=public

# ───────────────────────────────────────────────
#  LIMITES DIARIOS
# ───────────────────────────────────────────────
DEFAULT_LIMIT=10
PREMIUM_LIMIT=50

# ───────────────────────────────────────────────
#  API KEYS (opcionales: cada comando avisa si falta la suya)
# ───────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# https://home.openweathermap.org/api_keys
WEATHER_API_KEY=
# https://www.remove.bg/api
REMOVE_BG_API_KEY=

# ───────────────────────────────────────────────
#  AVANZADO (opcional)
# ───────────────────────────────────────────────
NODE_ENV=production
# trace | debug | info | warn | error
LOG_LEVEL=info
# Numero al que se enviara el Pairing Code (si se deja vacio se pregunta al iniciar)
PAIRING_NUMBER=
# Nombre de la carpeta de sesion dentro de ./sessions
SESSION_NAME=default
# Modelos usados por los comandos de IA
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_MODEL=gemini-2.0-flash
# Segundos de espera entre comandos por usuario
COMMAND_COOLDOWN=3
# Responder tambien en grupos (true/false)
ENABLE_GROUPS=true
# Marcar como leidos los mensajes que ejecutan comandos
AUTO_READ=false
