{
  "name": "bot-base",
  "version": "1.0.0",
  "description": "Bot de WhatsApp modular (Baileys + Node.js 20+) con plugins, permisos, XP, economia/RPG y base de datos persistente. Optimizado para Termux y Linux/VPS.",
  "type": "module",
  "main": "bot/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bot/index.js",
    "dev": "node --watch bot/index.js",
    "setup": "node scripts/setup.js",
    "reset-session": "node scripts/reset-session.js",
    "check": "node scripts/check.js",
    "clean": "node scripts/clean-temp.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "termux",
    "nodejs"
  ],
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "axios": "^1.12.2",
    "baileys": "^6.7.24",
    "dotenv": "^17.2.3",
    "file-type": "^21.1.0",
    "jimp": "^1.6.0",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.0",
    "pino": "^9.13.1",
    "pino-pretty": "^13.1.2",
    "qrcode-terminal": "^0.12.0"
  }
}
